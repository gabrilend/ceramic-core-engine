#!/usr/bin/env bash
# SoraMech development environment launcher.
# Starts the HTTP server in the background, waits for it to bind,
# then opens the visual editor in a browser.
# Usage: ./run [port]

# {{{ --help — render this script's header doc block and exit
# A standalone guard rather than a full argv parser: run takes only
# an optional [port], and catching -h/--help here means help works
# before we try to bind a socket. This same printer will be stamped
# verbatim into every SoraMech CLI entry point, so its exact shape
# is a deliberate, one-place design choice.
case "${1:-}" in
    -h|--help)
        # Print the top-of-file doc block as help: start at line 2
        # (skip the shebang), stop at the first blank line (skip the
        # inner fold/inline comments), strip the "# " marker.
        sed -n '2,/^$/s/^# \?//p' "$0"
        exit 0
        ;;
esac
# }}}

DIR="/mnt/mtwo/programs/sora/soramech"

PORT="${1:-7700}"

"${DIR}/scripts/start-server.sh" "${PORT}" &
SERVER_PID="${!}"

# wait for the server to accept connections
ATTEMPTS=0
until curl -s "http://localhost:${PORT}/" > /dev/null 2>&1; do
    ATTEMPTS=$((ATTEMPTS + 1))
    if [ "${ATTEMPTS}" -ge 20 ]; then
        echo "run: server did not start after 10 seconds" >&2
        kill "${SERVER_PID}" 2>/dev/null
        exit 1
    fi
    sleep 0.5
done

"${DIR}/scripts/open-editor.sh" "http://localhost:${PORT}"

echo "SoraMech running. Server PID: ${SERVER_PID}. Press Ctrl-C to stop."
wait "${SERVER_PID}"
