    },
    {
      "from_box": "router",
      "from_port": "low",
      "to_box": "write-low",
      "to_input": "n"
    },
    {
      "from_box": "router",
      "from_port": "high",
      "to_box": "write-high",
      "to_input": "n"
    },
    {
      "from_box": "router",
      "from_port": "else",
      "to_box": "write-low",
      "to_input": "n"
    }
  ],
  "ui": { "x": 320, "y": 170 }
}
