{
  "id": "router",
  "label": "Route by Size",
  "kind": "branch",
  "inputs": [
    { "name": "value", "type": "number" }
  ],
  "ports": [
    { "name": "low",  "predicate": { "op": "lt", "value": 50 } },
    { "name": "high", "predicate": { "op": "gte", "value": 50 } },
    { "name": "else" }
