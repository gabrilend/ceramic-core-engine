#!/usr/bin/env bash
#
# phase-1-pool — build and run the phase 1 demonstration.
#
# What this is: the front door to seeing the thread pool work. It
# compiles the demo program against the pool library and runs it; the
# program does all the measuring and talking.
#
# How it does it, in general terms: everything compiled lands in the
# RAM-backed build tier, the report lands in the shared-memory tier,
# and the project root is hard-coded but overridable by argument —
# the launcher passes it explicitly.
#
# This file keeps the launcher's phase-* naming rather than a numbered
# index, because the launcher discovers demos by that pattern. The
# demo's C source carries the index instead.

set -euo pipefail

DIR="/mnt/mtwo/programming/ai-playground/minimal-soramech"
if [[ $# -ge 1 && -d "$1" ]]; then
    DIR="$1"
fi

source "${DIR}/issues/completed/demos/059-demo-engine.sh"
sora_demo_paths "${DIR}"

SOURCE="${DIR}/issues/completed/demos/017-phase-1-pool-demo.c"
POOL="${DIR}/libs/012-pool.c"
BINARY="${BUILD}/phase-1-pool-demo"

# The one demo that does not link the engine, and deliberately so. The
# pool depends on nothing above it — it moves opaque structs and calls
# one function pointer per struct — and this demo proving it runs with
# nothing else present is worth more than the consistency of using the
# shared compile step. If this line ever needs another *engine* source
# file, something the pool should not know about has reached into it.
#
# The presenter beside it is not engine: it prints paragraphs and
# columns and has never heard of a station. It is here for the same
# reason it is in all six other demos — so the demos cannot drift into
# seven different layouts.
PRESENTER="${DIR}/issues/completed/demos/061-demo-scene.c"

gcc -std=gnu11 -Wall -Wextra -Werror -g -O2 -pthread \
    -I"${DIR}/libs" \
    -o "${BINARY}" "${SOURCE}" "${POOL}" "${PRESENTER}"

"${BINARY}" "${DIR}"

echo
echo "report mirrored at ${DIR}/tmp/shared-memory/phase-1-pool-report.txt"
