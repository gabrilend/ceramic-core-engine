#!/usr/bin/env bash
#
# phase-2-graph — build and run the phase 2 demonstration.
#
# What this is: the front door to seeing a graph run itself. A map is
# described, values are dropped in, and the machine fills every core
# without a scheduler; the program measures it happening.
#
# How it does it, in general terms: compiles the demo against the
# whole engine into the RAM-backed build tier and runs it with the
# project root as argument, so its report lands in the shared-memory
# tier. The scenes exercise only the phase 2 machinery; what the later
# phases added is present because the station layer now calls into it,
# not because this demo asks for it.
#
# Keeps the launcher's phase-* name; the C source carries the index.

set -euo pipefail

DIR="/mnt/mtwo/programming/ai-playground/minimal-soramech"
if [[ $# -ge 1 && -d "$1" ]]; then
    DIR="$1"
fi

source "${DIR}/issues/completed/demos/059-demo-engine.sh"
sora_demo_paths "${DIR}"

SOURCE="${DIR}/issues/completed/demos/025-phase-2-graph-demo.c"
BINARY="${BUILD}/phase-2-graph-demo"

# This demo builds its maps by hand and carries its own shims, so it
# needs no box registry of its own — but the station layer it links
# against reaches into the statics table and the observer, which the
# registry-bearing engine expects to be whole. Regenerate, then link
# the engine entire; see the shared build front for why the old
# per-phase source list could not survive phase 7.
sora_demo_registry "${DIR}"
sora_demo_compile "${DIR}" "${BINARY}" "${SOURCE}"

"${BINARY}" "${DIR}"

echo
echo "report mirrored at ${DIR}/tmp/shared-memory/phase-2-graph-report.txt"
