#!/usr/bin/env bash
#
# phase-4-pull — build and run the phase 4 demonstration.
#
# What this is: the front door to the pull path. A pushed value was
# true once; a gathered value is true now — the program stages the
# difference, measures gathering's tax, and turns a knob on a
# running machine.
#
# How it does it, in general terms: regenerates the registry the way
# make would, compiles the demo against the whole engine into the
# RAM-backed tier, and runs it with the project root so its report
# and its watched file land in shared memory.
#
# Keeps the launcher's phase-* name; the C source carries the index.

set -euo pipefail

DIR="/mnt/mtwo/programming/ai-playground/minimal-soramech"
if [[ $# -ge 1 && -d "$1" ]]; then
    DIR="$1"
fi

BUILD="/tmp/$(basename "${DIR}")/build"
SHARED="/dev/shm/$(basename "${DIR}")"
mkdir -p "${BUILD}" "${SHARED}"

mkdir -p "${DIR}/src/generated"
luajit "${DIR}/scripts/028-generate.lua" \
    "${DIR}/src/generated/registry.c" ${DIR}/src/boxes/*.c

SOURCE="${DIR}/issues/completed/demos/037-phase-4-pull-demo.c"
BINARY="${BUILD}/phase-4-pull-demo"

gcc -std=gnu11 -Wall -Wextra -Werror -g -O2 -pthread \
    -I"${DIR}/libs" -I"${DIR}/src" \
    -o "${BINARY}" "${SOURCE}" \
    "${DIR}/libs/012-pool.c" "${DIR}/src/019-station.c" \
    "${DIR}/src/020-delivery.c" "${DIR}/src/027-registry-support.c" \
    "${DIR}/src/033-statics.c" "${DIR}/src/034-gather.c" \
    "${DIR}/src/generated/registry.c"

"${BINARY}" "${DIR}"

echo
echo "report mirrored at ${DIR}/tmp/shared-memory/phase-4-pull-report.txt"
