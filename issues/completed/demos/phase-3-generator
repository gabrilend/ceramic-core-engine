#!/usr/bin/env bash
#
# phase-3-generator — the phase 3 demonstration, driven from the shell
# so the rebuild steps are visible as they happen.
#
# What this is: the demo of the seam between the two halves of a
# program. The only thing an author writes is ordinary C; everything
# the engine needs is derived from it. Seven scenes, told as a library
# that catalogues itself, a translator's booth, a parts book, two
# surveyors, a loading door, a car on a familiar track, and a passport
# photograph that no longer matches the face.
#
# How it does it, in general terms: scenes one, two and seven are
# shell work — running the generator over a scratch copy of the box
# sources in the RAM tier, so the real project is never touched — and
# scenes three to six come from a compiled program invoked in the
# middle, which appends to the same report rather than starting its
# own. Both halves speak through the shared presenters, so the seams
# do not show.

set -euo pipefail

DIR="/mnt/mtwo/programming/ai-playground/minimal-soramech"
if [[ $# -ge 1 && -d "$1" ]]; then
    DIR="$1"
fi

source "${DIR}/issues/completed/demos/059-demo-engine.sh"
source "${DIR}/issues/completed/demos/062-demo-scene.sh"
sora_demo_paths "${DIR}"

SCRATCH="/tmp/$(basename "${DIR}")/phase-3-scratch"
rm -rf "${SCRATCH}"
mkdir -p "${SCRATCH}"

GENERATOR="${DIR}/scripts/028-generate.lua"
BOXES="${DIR}/src/boxes/029-demo-boxes.c"

sora_demo_open "${SHARED}/phase-3-registry-demo.txt" \
    "=== phase 3 demo: writing a box is writing a function ==="

# --- scene 1: a box added live -------------------------------------
sora_scene_open 1 "adding a box is writing a function, and nothing else"

sora_scene_problem \
"In most systems, making a new component available means writing it
and then telling something about it — a registration call, an entry in
a table, a line in a build file. Every one of those is a second place
that can disagree with the first. Here the generator parses whatever C
files sit in the box directory and emits the registry from what it
finds, every build. So the function is the entire change: this scene
appends one to a scratch copy of the box source and shows the registry
growing with real types and real sizes, with nothing else edited
anywhere."

sora_scene_imagine \
"a library where shelving a book is the whole of acquiring it. You
carry it in, you put it on the shelf, and the card catalogue has an
entry for it — not because you filled in a card, but because the
catalogue is printed each morning by walking the shelves."

sora_scene_stands_for "writing a box function" "shelving a book" \
"each is the one real act of adding something, and in both cases the
thing itself is now present and usable regardless of what any index
says about it"

sora_scene_stands_for "the generated registry" "the card catalogue" \
"each is the index everything else consults, and each is worthless the
moment it describes a collection that differs from what is actually on
the shelves"

sora_scene_stands_for "parsing the box sources" "walking the shelves" \
"both build the index by looking at the real thing, so an entry cannot
exist for something absent and nothing present can be missing from it"

sora_scene_stands_for "regenerating every build" "printing it each morning" \
"both make the index a derived artifact with no life of its own, which
is what removes the possibility of it drifting out of date"

cp "${BOXES}" "${SCRATCH}/boxes.c"
luajit "${GENERATOR}" "${SCRATCH}/registry.c" "${SCRATCH}/boxes.c"
BEFORE=$(grep -c '__call(task_t' "${SCRATCH}/registry.c")

cat >> "${SCRATCH}/boxes.c" <<'EOF'

/* Added live by the phase 3 demo: no registration, no list, no
 * build-file edit — the function is the entire change. */
double live_added(int x, double weight)
{
    return x * weight;
}
EOF

luajit "${GENERATOR}" "${SCRATCH}/registry.c" "${SCRATCH}/boxes.c"
AFTER=$(grep -c '__call(task_t' "${SCRATCH}/registry.c")

sora_scene_measured "books on the shelf" "${BEFORE} books" "${BEFORE} boxes"
sora_scene_measured "one book shelved" "1 function appended" "no other edit"
sora_scene_measured "cards in the catalogue" "${AFTER} cards" "${AFTER} boxes"

sora_scene_blank
sora_scene_line "the card that wrote itself:"
CARD=$(grep -A1 '"live_added"' "${SCRATCH}/registry.c")
printf '%s\n' "${CARD}" | sora_scene_quote

sora_scene_finding \
"Real types, real sizes, and not a single other edit anywhere — no
list of boxes, no registration call, no line added to the build. The
catalogue grew because the shelf did. This is the phase's entire
claim, and everything that follows is a consequence of it."

# --- scene 2: the shim beside its function -------------------------
sora_scene_open 2 "the glue nobody has to write"

sora_scene_problem \
"A box author writes ordinary C: named arguments of particular types,
a return value. The engine deals in untyped storage at known offsets,
because it has to move values whose types it cannot know. Something
has to convert between the two, per box, exactly right. That something
is the shim, and the point of this scene is what the shim was derived
from — nothing but the author's own declaration, which is the only
description of their meaning that cannot be out of date."

sora_scene_imagine \
"two people doing business without a shared language, and a translator
between them who was never briefed. They worked out what to say
entirely by reading what one side had already written down."

sora_scene_stands_for "a C declaration" "one side's language" \
"each is a complete statement of intent in a form its author finds
natural, made without any thought for who will have to interpret it"

sora_scene_stands_for "void pointers and offsets" "the other side's language" \
"each is a form that carries anything precisely because it means
nothing on its own, and each is unusable without something that knows
how to read it"

sora_scene_stands_for "the generated shim" "the translator" \
"each stands between two parties that never adapt to each other, and
each exists purely so that neither has to"

sora_scene_stands_for "the declaration being the only input" "nobody briefing them" \
"in both cases there is exactly one source of truth, so there is no
second document to keep in step and no way for a briefing to be stale"

sora_scene_blank
sora_scene_line "what the author wrote:"
sed -n '/^int add(/,/^}/p' "${BOXES}" | sora_scene_quote

sora_scene_blank
sora_scene_line "what the translator says on their behalf:"
sed -n '/generated from: int add/,/^}/p' "${DIR}/src/generated/registry.c" \
    | sora_scene_quote

sora_scene_finding \
"The author never mentioned the engine and the engine never learned
the author's types. Everything in the lower block was derived from the
upper one, including the exact widths of the copies — and the timing
hooks, which appear only when the build asks for statistics. A person
maintaining the upper block cannot forget to update the lower one,
because there is nobody to do the forgetting."

# --- scenes 3 to 6: the compiled half ------------------------------
# It appends to the report opened above, so the document stays whole.
SOURCE="${DIR}/issues/completed/demos/032-phase-3-registry-demo.c"
BINARY="${BUILD}/phase-3-registry-demo"

# Regenerate the real registry first, exactly as make would.
sora_demo_registry "${DIR}"
sora_demo_compile "${DIR}" "${BINARY}" "${SOURCE}"

# Hand the page over cleanly: the compiled half runs its own pager, and
# it must not inherit a row count it did not write.
sora_demo_page_break
"${BINARY}" "${DIR}"

# --- scene 7: a box changed out from under its registry ------------
sora_scene_open 7 "what stops the registry describing yesterday's code"

sora_scene_problem \
"A derived document is only safe if it cannot survive the thing it
describes. If a box's return type changes and the registry does not,
the shim casts the result to a type the function no longer returns —
which compiles, runs, and is wrong. Two rules prevent it. The build
regenerates before it compiles, so the registry is always of today's
sources. And a generator that fails writes nothing into place, so
there is no path by which a stale registry can be the newest one. This
scene changes a box's return type and watches its row follow."

sora_scene_imagine \
"a passport photograph, which is not the person. Grow a beard and the
document quietly stops being true: it still opens gates, it still
looks official, and it now vouches for somebody who does not exist."

sora_scene_stands_for "a box function as written today" "the face" \
"each is the actual thing, changing whenever its owner decides, with
no obligation to notify anybody who wrote something down about it
earlier"

sora_scene_stands_for "its row in the registry" "the photograph" \
"each is a description captured at one moment that everything
downstream then treats as authoritative, which is exactly what makes a
stale one dangerous rather than merely useless"

sora_scene_stands_for "changing a return type" "growing a beard" \
"both are ordinary, legitimate changes that nobody should have to ask
permission for, and both silently invalidate every document made
before them"

sora_scene_stands_for "regenerating before compiling" "retaking the photo" \
"both refresh the description at the one moment it is about to be
relied on, which is the only timing that closes the gap completely"

OLD_LINE=$(grep '"live_added"' "${SCRATCH}/registry.c")
sora_scene_blank
sora_scene_line "the photograph, while the function returned double:"
printf '%s\n' "${OLD_LINE}" | sora_scene_quote

sed -i 's/^double live_added/float live_added/' "${SCRATCH}/boxes.c"
sed -i 's/return x \* weight;/return (float)(x * weight);/' "${SCRATCH}/boxes.c"
luajit "${GENERATOR}" "${SCRATCH}/registry.c" "${SCRATCH}/boxes.c"
NEW_LINE=$(grep '"live_added"' "${SCRATCH}/registry.c")

sora_scene_blank
sora_scene_line "the photograph, after the face changed:"
printf '%s\n' "${NEW_LINE}" | sora_scene_quote

sora_scene_finding \
"The build regenerates before it compiles, so the document is always
of today's face. And a generator that fails writes nothing into place
— the passport office issues nothing rather than reissuing yesterday's
photograph. A shim that casts to a type the function no longer returns
cannot exist here, which is a stronger guarantee than any amount of
remembering to rerun something."

sora_demo_close "=== the author wrote C; everything else was derived ==="

echo
echo "report mirrored at ${DIR}/tmp/shared-memory/phase-3-registry-demo.txt"

rm -rf "${SCRATCH}"
