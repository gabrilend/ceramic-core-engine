#!/usr/bin/env bash
#
# phase-7-inside — the final demonstration: watching it think.
#
# What this is: the engine made legible while it runs. A live map
# under load, a bottleneck found with the engine's own reports and
# relieved by moving a wire mid-run, the dump proving the picture
# and the machine agree, and a refused rewire that kills nothing.
# Then the measurement apparatus itself is measured: the same
# workload compiled with statistics in and out.
#
# How it does it, in general terms: opens the report and says what
# to expect, builds the demo binary twice — once plain, once with
# -DSORA_STATS — lets the instrumented build tell scenes one to five
# into that same report, then runs the bare throughput mode from both
# builds and tells scene six itself. Scene six has to live here
# because neither build can measure the other one.
#
# The sixth story is a thermometer that warms the room it is
# measuring; the other five are in the C source. See issue 707 for
# the contract they answer to.

set -euo pipefail

DIR="/mnt/mtwo/programming/ai-playground/minimal-soramech"
if [[ $# -ge 1 && -d "$1" ]]; then
    DIR="$1"
fi

source "${DIR}/issues/completed/demos/059-demo-engine.sh"
source "${DIR}/issues/completed/demos/062-demo-scene.sh"
sora_demo_paths "${DIR}"

sora_demo_registry "${DIR}"

# The same demo source, the same engine, twice — the only difference
# is the flag that compiles the statistics in. Anything else differing
# between the two builds would make scene six's comparison meaningless,
# which is why both go through one build front.
SOURCE="${DIR}/issues/completed/demos/055-phase-7-inside-demo.c"

sora_demo_compile "${DIR}" "${BUILD}/phase-7-inside-stats" "${SOURCE}" -DSORA_STATS
sora_demo_compile "${DIR}" "${BUILD}/phase-7-inside-plain" "${SOURCE}"

sora_demo_open "${SHARED}/phase-7-inside-report.txt" \
    "=== phase 7 demo: watching it think ==="

sora_demo_note \
"Two voices below. Everything indented is this demo speaking;
unindented lines are the engine itself, saying what it is loading,
which station it seeded, and what it refuses to do. Those are worth
reading rather than scrolling past — the point of this phase is that
the engine says what it is doing while it does it."

sora_demo_note \
"One of them arrives before scene one: the loader warns that a station
called 'spare' has an input no arrow feeds. That is correct, and it is
deliberate. The spare sits idle until scene two moves a wire onto it
while the map is running. It is here so a reader learns what that
warning looks like when it is expected, rather than learning to ignore
warnings."

# Scenes one to five, from the instrumented build. It appends to the
# report opened above, so the six scenes are one document.
"${BUILD}/phase-7-inside-stats" "${DIR}"

# ------------------------------------------------------------------
# Scene 6: the cost of measuring, which needs both builds.
# ------------------------------------------------------------------
sora_scene_open 6 "what the instruments cost the thing they measure"

sora_scene_problem \
"Every report in this phase is produced by code that runs inside the
engine's hot paths — a clock read before and after each box call, a
counter incremented per run, a timer on every mutex wait. That is not
free, and a demo that showed the reports without pricing them would be
asking the reader to take the cost on trust. The instrumentation is a
compile-time choice rather than a runtime flag, so the build without
it contains no branch and no counter at all. Pricing it therefore
means building the same source twice and running both."

sora_scene_imagine \
"a thermometer left in a glass of water, which takes a little heat
from the water in order to read it. Usually the disturbance is too
small to care about — and the only way to know that is to run the
experiment twice, once with the instrument in the glass and once
without."

sora_scene_stands_for "the same map and workload" "the water in the glass" \
"both are held identical across the two runs, because the whole
comparison depends on the only difference being the instrument"

sora_scene_stands_for "per-box timing and counters" "the thermometer" \
"each has to be in contact with the thing it measures in order to
measure it, which is exactly why it cannot help but take something
from it"

sora_scene_stands_for "compiling without -DSORA_STATS" "taking the thermometer out" \
"in both cases the instrument is genuinely absent rather than switched
off and idle, so what is left is the undisturbed thing"

sora_scene_stands_for "two binaries from one source" "running the experiment twice" \
"both isolate the instrument's effect by changing nothing else at all,
which is the only way a difference can be attributed to it"

# Measuring this honestly took three attempts, and the two failures are
# worth recording because both produced confident wrong numbers.
#
# One run of each said the instrumented build was FASTER, which is
# impossible — it does strictly more work. That was the machine's other
# activity landing on one run and not the other.
#
# Best-of-five each, run as two blocks, said the same thing just as
# confidently. The bias was the ordering: whichever build ran second
# inherited a warmed cache and a processor that had already scaled up,
# and five repetitions made that bias precise rather than removing it.
# A measurement repeated carefully is not the same as a measurement
# taken fairly.
#
# So: one discarded warm-up of each, then five rounds that alternate,
# keeping each build's fastest. Alternating spreads any remaining drift
# across both builds instead of donating it to one.
"${BUILD}/phase-7-inside-plain" "${DIR}" --overhead > /dev/null 2>&1
"${BUILD}/phase-7-inside-stats" "${DIR}" --overhead > /dev/null 2>&1

PLAIN=0
STATS=0
for round in 1 2 3 4 5; do
    RUN=$("${BUILD}/phase-7-inside-plain" "${DIR}" --overhead 2>/dev/null)
    if (( RUN > PLAIN )); then
        PLAIN="${RUN}"
    fi
    RUN=$("${BUILD}/phase-7-inside-stats" "${DIR}" --overhead 2>/dev/null)
    if (( RUN > STATS )); then
        STATS="${RUN}"
    fi
done

# Integer arithmetic in the shell, so the percentage is derived from
# the two measured rates and nothing else.
COST=$(( (PLAIN - STATS) * 100 / PLAIN ))

sora_scene_measured "thermometer out" "${PLAIN} tasks/second" "best of five, alternated"
sora_scene_measured "thermometer in" "${STATS} tasks/second" "best of five, alternated"
sora_scene_measured "heat taken" "${COST}%" "of throughput, this run"

# What the number means depends on its sign, and a negative one has to
# be said out loud rather than quietly rounded to zero: it means the
# instrumented build came out ahead, which can only be noise, and
# pretending otherwise would be exactly the kind of tidy lie this
# scene exists to argue against.
if (( COST > 0 )); then
    VERDICT="The cost is real and small."
else
    VERDICT="The instrumented build came out ahead this time, which is
impossible and therefore noise: the true cost is below what five runs
on a busy machine can resolve."
fi

sora_scene_finding \
"A measurement apparatus whose cost is unmeasured is a rumour.
${VERDICT} The instrumentation is a compile-time choice rather than a
runtime flag, so the build without it contains no branch, no counter
and no clock call — the timing code is not skipped, it is absent. That
is why the difference is hard to see at all, and why it had to be
produced by building the program twice rather than by asking the
instrumented build how much it thought it was costing itself."

sora_demo_close "=== nothing hidden: seen, changed, and still true ==="

echo
echo "report mirrored at ${DIR}/tmp/shared-memory/phase-7-inside-report.txt"
