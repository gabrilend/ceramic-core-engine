#!/usr/bin/env bash
#
# phase-6-mapfile — the capstone demonstration.
#
# What this is: proof that a program is a directory of C functions
# and a text file. One compiled binary runs three genuinely different
# programs from three map files; a map is edited between runs and the
# behaviour follows with the compiler never invoked; every error
# message is triggered on purpose; and the everything-map runs the
# machinery of all six phases at once, drawn from the loaded table.
#
# How it does it, in general terms: builds the runner binary once at
# the top, then never compiles again. Maps are copied into the RAM
# tier with their output paths patched in, edited there with sed, and
# handed to the same binary each time. Deliberately broken maps are
# generated on the spot and each failure is shown verbatim.

set -euo pipefail

DIR="/mnt/mtwo/programming/ai-playground/minimal-soramech"
if [[ $# -ge 1 && -d "$1" ]]; then
    DIR="$1"
fi

BUILD="/tmp/$(basename "${DIR}")/build"
SHARED="/dev/shm/$(basename "${DIR}")"
WORK="${SHARED}/phase-6-work"
REPORT="${SHARED}/phase-6-capstone-report.txt"
mkdir -p "${BUILD}" "${SHARED}"
rm -rf "${WORK}"
mkdir -p "${WORK}"
: > "${REPORT}"

MAPS="${DIR}/issues/completed/demos/maps"
RUNNER="${BUILD}/run-map"

tell() {
    echo "$1" | tee -a "${REPORT}"
}

# ------------------------------------------------------------------
# The one compile of the entire demo.
# ------------------------------------------------------------------
mkdir -p "${DIR}/src/generated"
luajit "${DIR}/scripts/028-generate.lua" \
    "${DIR}/src/generated/registry.c" ${DIR}/src/boxes/*.c

gcc -std=gnu11 -Wall -Wextra -Werror -g -O2 -pthread \
    -I"${DIR}/libs" -I"${DIR}/src" \
    -o "${RUNNER}" \
    "${DIR}/issues/completed/demos/044-phase-6-run-map.c" \
    "${DIR}/libs/012-pool.c" "${DIR}/src/019-station.c" \
    "${DIR}/src/020-delivery.c" "${DIR}/src/027-registry-support.c" \
    "${DIR}/src/033-statics.c" "${DIR}/src/034-gather.c" \
    "${DIR}/src/041-mapfile.c" "${DIR}/src/042-loader.c" \
    "${DIR}/src/generated/registry.c"

tell "=== phase 6 demo: the capstone ==="
tell ""
tell "one binary was compiled, above. everything below is text files."
tell ""

# ------------------------------------------------------------------
# Scene: the same binary, three different programs.
# ------------------------------------------------------------------
tell "scene 1 — one binary, three programs"

sed "s|OUTPUT_PATH|${WORK}/chain.txt|" \
    "${MAPS}/045-chain.map" > "${WORK}/chain.map"
"${RUNNER}" "${WORK}/chain.map" --quiet 2>/dev/null
tell "  045-chain.map:    seven doubled twice   -> $(cat "${WORK}/chain.txt")"

sed "s|OUTPUT_PATH|${WORK}/gathered.txt|" \
    "${MAPS}/046-gathered.map" > "${WORK}/gathered.map"
"${RUNNER}" "${WORK}/gathered.map" --quiet 2>/dev/null
tell "  046-gathered.map: pushed 7 + pulled 7   -> $(cat "${WORK}/gathered.txt")"

sed -e "s|LOW_PATH|${WORK}/low.txt|" -e "s|HIGH_PATH|${WORK}/high.txt|" \
    "${MAPS}/047-gate.map" > "${WORK}/gate.map"
rm -f "${WORK}/low.txt" "${WORK}/high.txt"
"${RUNNER}" "${WORK}/gate.map" --quiet 2>/dev/null
tell "  047-gate.map:     7 against 5, routed   -> high.txt holds $(cat "${WORK}/high.txt" 2>/dev/null || echo nothing), low.txt $(cat "${WORK}/low.txt" 2>/dev/null || echo "does not exist")"
tell "  three behaviours, zero recompiles"
tell ""

# ------------------------------------------------------------------
# Scene: a map edited between runs.
# ------------------------------------------------------------------
tell "scene 2 — the shape changes; the C does not"
sed -i 's|out 0 - twice.0|out 0 - sink.1|; /^twice double_it p$/,+1d' \
    "${WORK}/chain.map"
"${RUNNER}" "${WORK}/chain.map" --quiet 2>/dev/null
tell "  one wire redrawn in the text (a doubling hop removed): -> $(cat "${WORK}/chain.txt")"

sed -i 's|2 = 5|2 = 100|' "${WORK}/gate.map"
rm -f "${WORK}/low.txt" "${WORK}/high.txt"
"${RUNNER}" "${WORK}/gate.map" --quiet 2>/dev/null
tell "  one threshold turned from 5 to 100:  -> low.txt holds $(cat "${WORK}/low.txt" 2>/dev/null || echo nothing), high.txt $(cat "${WORK}/high.txt" 2>/dev/null || echo "does not exist")"
tell "  the compiler was never invoked"
tell ""

# ------------------------------------------------------------------
# Scene: every error message, deliberately.
# ------------------------------------------------------------------
tell "scene 3 — the failure modes are the surface a person touches"

try_bad() {
    local label="$1"
    local text="$2"
    printf '%s\n' "${text}" > "${WORK}/bad.map"
    set +e
    local words
    words=$("${RUNNER}" "${WORK}/bad.map" --quiet 2>&1 >/dev/null | head -2)
    set -e
    tell "  ${label}:"
    echo "${words}" | sed 's/^/    /' | tee -a "${REPORT}"
}

try_bad "a misspelled box" \
"head sevn p"

try_bad "an arrow to a station that does not exist" \
"head seven p
  out 0 - nowhere.0"

try_bad "a type mismatch on a wire" \
"head seven p
  out 0 - wrong.1
wrong mix p"

try_bad "a gather cycle" \
"a keep p
  in 0 b
b keep p
  in 0 a"

try_bad "a comparator that cannot compare" \
"quiet swallow c"

try_bad "a map with nothing to seed" \
"lonely add p"
tell ""

# ------------------------------------------------------------------
# Scene: everything at once, drawn from the loaded table.
# ------------------------------------------------------------------
tell "scene 4 — every phase's machinery in one map, drawn as built"
sed -e "s|OUT_A|${WORK}/everything-a.txt|" -e "s|OUT_B|${WORK}/everything-b.txt|" \
    "${MAPS}/048-everything.map" > "${WORK}/everything.map"
"${RUNNER}" "${WORK}/everything.map" 2>&1 | tee -a "${REPORT}"
tell "  pool, stations, generated boxes, a gatherer, statics, a"
tell "  comparator, an iterator — one map, and the picture above was"
tell "  drawn from the station table, never from the file"
tell "  outputs: a=$(cat "${WORK}/everything-a.txt"), b=$(cat "${WORK}/everything-b.txt")"
tell ""
tell "=== a program is a directory of C functions and a text file ==="
echo
echo "report mirrored at ${DIR}/tmp/shared-memory/phase-6-capstone-report.txt"
