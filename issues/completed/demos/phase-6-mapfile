#!/usr/bin/env bash
#
# phase-6-mapfile — the capstone demonstration.
#
# What this is: proof that a program is a directory of C functions
# and a text file. One compiled binary runs three genuinely different
# programs from three map files; a map is edited between runs and the
# behaviour follows with the compiler never invoked; every error
# message is triggered on purpose; and the everything-map runs the
# machinery of all six phases at once, drawn from the loaded table.
#
# How it does it, in general terms: builds the runner binary once at
# the top, then never compiles again. Maps are copied into the RAM
# tier with their output paths patched in, edited there with sed, and
# handed to the same binary each time. Deliberately broken maps are
# generated on the spot and each failure is shown verbatim.
#
# The four stories are a player piano, a railway signal box, a customs
# desk, and an orchestra's first full rehearsal. Each was chosen for a
# different mechanic; see issue 707 for the contract they answer to.

set -euo pipefail

DIR="/mnt/mtwo/programming/ai-playground/minimal-soramech"
if [[ $# -ge 1 && -d "$1" ]]; then
    DIR="$1"
fi

source "${DIR}/issues/completed/demos/059-demo-engine.sh"
source "${DIR}/issues/completed/demos/062-demo-scene.sh"
sora_demo_paths "${DIR}"

WORK="${SHARED}/phase-6-work"
rm -rf "${WORK}"
mkdir -p "${WORK}"

MAPS="${DIR}/issues/completed/demos/maps"
RUNNER="${BUILD}/run-map"

# ------------------------------------------------------------------
# The one compile of the entire demo.
# ------------------------------------------------------------------
sora_demo_registry "${DIR}"
sora_demo_compile "${DIR}" "${RUNNER}" \
    "${DIR}/issues/completed/demos/044-phase-6-run-map.c"

sora_demo_open "${SHARED}/phase-6-capstone-report.txt" \
    "=== phase 6 demo: the capstone ==="

sora_demo_note \
"One binary was compiled, above, and it is the last compilation in
this demo. Everything below is text files."

# ------------------------------------------------------------------
# Scene 1: the same binary, three different programs.
# ------------------------------------------------------------------
sora_scene_open 1 "one binary, three genuinely different programs"

sora_scene_problem \
"A map file names stations, says which box each one runs, wires ports
to slots, and gives values for statics. The loader reads it, looks
every box up in the registry, type-checks every wire, and builds the
station table. Nothing in that path is specific to any one map — so
the same compiled binary runs any map it is handed. This scene runs
three of them: a chain of transformations, a value pulled on demand,
and a routed comparison. One compile, at the top of this script, and
none after it."

sora_scene_imagine \
"a player piano: a fixed mechanism of hammers and bellows that never
changes, and a paper roll with holes punched in it that does. Two
rolls are two different pieces of music, and nobody would describe
changing the roll as building a new piano."

sora_scene_stands_for "the compiled binary" "the piano mechanism" \
"each is a fixed general-purpose machine built once, capable of
anything within its range and committed to nothing in particular"

sora_scene_stands_for "a map file" "a paper roll" \
"each is the entire specification of one particular behaviour, held
outside the machine in a form a person can read and alter"

sora_scene_stands_for "stations, wires and statics" "the punched holes" \
"each is the actual encoding — not a description of the program but
the program itself, in the only form the machine reads"

sora_scene_stands_for "what the program does" "the music" \
"both are the whole point and neither lives in the mechanism, which is
what makes swapping the roll a change of program rather than a change
of setting"

sed "s|OUTPUT_PATH|${WORK}/chain.txt|" \
    "${MAPS}/045-chain.map" > "${WORK}/chain.map"
"${RUNNER}" "${WORK}/chain.map" --quiet 2>/dev/null
CHAIN_OUT=$(cat "${WORK}/chain.txt")

sed "s|OUTPUT_PATH|${WORK}/gathered.txt|" \
    "${MAPS}/046-gathered.map" > "${WORK}/gathered.map"
"${RUNNER}" "${WORK}/gathered.map" --quiet 2>/dev/null
GATHERED_OUT=$(cat "${WORK}/gathered.txt")

sed -e "s|LOW_PATH|${WORK}/low.txt|" -e "s|HIGH_PATH|${WORK}/high.txt|" \
    "${MAPS}/047-gate.map" > "${WORK}/gate.map"
rm -f "${WORK}/low.txt" "${WORK}/high.txt"
"${RUNNER}" "${WORK}/gate.map" --quiet 2>/dev/null
HIGH_OUT=$(cat "${WORK}/high.txt" 2>/dev/null || echo "nothing")
LOW_OUT=$(cat "${WORK}/low.txt" 2>/dev/null || echo "no file at all")

sora_scene_measured "first roll" "seven, doubled twice" "-> ${CHAIN_OUT}"
sora_scene_measured "second roll" "pushed 7 plus pulled 7" "-> ${GATHERED_OUT}"
sora_scene_measured "third roll" "7 against a gate of 5" "-> high ${HIGH_OUT}, low ${LOW_OUT}"
sora_scene_measured "pianos built" "1" "one compile, at the top"
sora_scene_measured "recompiles" "0" "between any two of the above"

sora_scene_finding \
"Three genuinely different behaviours — a chain of transformations, a
value pulled on demand, a routed comparison — and one binary that was
never touched between them. The third roll is worth a second look: the
low output file does not exist, because nothing was ever routed there.
An unwired port does not write an empty file; it does not write."

# ------------------------------------------------------------------
# Scene 2: a map edited between runs.
# ------------------------------------------------------------------
sora_scene_open 2 "changing the program without touching the code"

sora_scene_problem \
"Because the shape of the program is in the text file rather than in
the C, changing the shape is editing text. This scene removes a
station from a chain by deleting two lines and redirecting one arrow,
then changes a comparator's threshold by editing one number — and the
compiler is not invoked between any of it. What is worth noticing is
which part of a program changes most often: it is almost always the
wiring and the constants, and those are now the part that is not
code."

sora_scene_imagine \
"a railway signal box, a room of levers overlooking the tracks.
Pulling one moves a set of points, and from that moment every train
takes the other line. Nothing about any locomotive changed and nobody
visited a workshop."

sora_scene_stands_for "a line in the map file" "a lever in the box" \
"each is a single small control that a person operates directly, and
each takes effect on everything that comes afterwards without touching
anything that has already gone"

sora_scene_stands_for "an arrow between stations" "a set of points" \
"both determine where things go without doing anything to the things
themselves, which is why changing one changes the outcome and nothing
else"

sora_scene_stands_for "a compiled box function" "a locomotive" \
"each is an expensive, separately built thing that does its own job
correctly wherever it is sent, and neither needs to know which route
it is currently on"

sora_scene_stands_for "recompiling" "a visit to the workshop" \
"both are the slow, heavy operation that this arrangement exists to
avoid needing, and neither happens anywhere in this scene"

sed -i 's|out 0 - twice.0|out 0 - sink.1|; /^twice double_it p$/,+1d' \
    "${WORK}/chain.map"
"${RUNNER}" "${WORK}/chain.map" --quiet 2>/dev/null
CHAIN_AFTER=$(cat "${WORK}/chain.txt")

sed -i 's|2 = 5|2 = 100|' "${WORK}/gate.map"
rm -f "${WORK}/low.txt" "${WORK}/high.txt"
"${RUNNER}" "${WORK}/gate.map" --quiet 2>/dev/null
LOW_AFTER=$(cat "${WORK}/low.txt" 2>/dev/null || echo "nothing")
HIGH_AFTER=$(cat "${WORK}/high.txt" 2>/dev/null || echo "no file at all")

sora_scene_measured "the chain, before" "${CHAIN_OUT}" "seven doubled twice"
sora_scene_measured "one wire redrawn" "a doubling hop removed" "one edit, in text"
sora_scene_measured "the chain, after" "${CHAIN_AFTER}" "the other line, taken"
sora_scene_measured "the gate, before" "high ${HIGH_OUT}" "threshold 5"
sora_scene_measured "one lever pulled" "5 becomes 100" "one number, in text"
sora_scene_measured "the gate, after" "low ${LOW_AFTER}" "high ${HIGH_AFTER}"
sora_scene_measured "compiler invocations" "0" "the workshop stayed shut"

sora_scene_finding \
"Changing the shape of the program did not require touching the C, and
changing a threshold did not require touching anything but a number.
This is the whole of what phase 6 bought: the part of a program that
changes most often is now the part that is not code, and the part that
is code has stopped needing to know what shape it is being used in."

# ------------------------------------------------------------------
# Scene 3: every error message, deliberately.
# ------------------------------------------------------------------
sora_scene_open 3 "the error messages, which are the real interface"

sora_scene_problem \
"Once the program's shape is a text file, most of what a person
actually does is write that file wrongly and be told why. The loader
validates in two passes: names are resolved first, then every wire is
type-checked against the registry, gather chains are walked for
cycles, comparators are checked for a comparable return type, and the
map is checked for anything to seed at all. Each failure names the
file, the line where it can be found, and the thing that is wrong.
This scene triggers six of them on purpose and quotes each verbatim."

sora_scene_imagine \
"two customs desks rejecting the same form. The first officer says
\"rejected\" and turns away. The second says the declared value on line
four does not match the attached invoice, names both figures, and
points at the desk where it can be fixed."

sora_scene_stands_for "a map file with a mistake" "the rejected form" \
"each was written in good faith by somebody who believed it was
correct, so what happens next decides whether they can find out what
they got wrong"

sora_scene_stands_for "the loader's validation pass" "the officer at the desk" \
"each is the only thing standing between a wrong document and a
system that acts on it, and each has all the information needed to
explain the problem at the moment it is found"

sora_scene_stands_for "the message the loader prints" "naming the line" \
"both convert a refusal into a repair, which is the entire difference
between an obstacle and a tool"

sora_scene_stands_for "a crash or a wrong answer" "the unhelpful desk" \
"both refuse just as effectively and teach nothing, leaving the person
to guess — which is how a system acquires a reputation for being
mysterious"

# {{{ try_bad()
# Feeds the runner a deliberately broken map and quotes what it says
# back, verbatim. Verbatim matters: a demo that paraphrases an error
# message can be wrong about it, and this one cannot.
try_bad()
{
    local label="$1"
    local text="$2"
    local words

    printf '%s\n' "${text}" > "${WORK}/bad.map"
    set +e
    words=$("${RUNNER}" "${WORK}/bad.map" --quiet 2>&1 >/dev/null | head -2)
    set -e

    # One blank between refusals: six of them run together read as a
    # wall of red rather than as six separate answers.
    sora_scene_blank
    sora_scene_line "${label}:"
    printf '%s\n' "${words}" | sora_scene_quote
}
# }}}

sora_scene_blank

try_bad "a misspelled box" \
"head sevn p"

try_bad "an arrow to a station that does not exist" \
"head seven p
  out 0 - nowhere.0"

try_bad "a type mismatch on a wire" \
"head seven p
  out 0 - wrong.1
wrong mix p"

try_bad "a gather cycle" \
"a keep p
  in 0 b
b keep p
  in 0 a"

try_bad "a comparator that cannot compare" \
"quiet swallow c"

try_bad "a map with nothing to seed" \
"lonely add p"

sora_scene_finding \
"Six ways to write a map that cannot work, and six refusals that each
name the thing that is wrong and where it is. None of them is a crash
and none of them is a program that runs and quietly produces the wrong
answer. These messages are the surface a person actually touches —
more often than they touch anything else here — which is why they are
tested rather than merely written."

# ------------------------------------------------------------------
# Scene 4: everything at once, drawn from the loaded table.
# ------------------------------------------------------------------
sora_scene_open 4 "all six phases in one map, at the same time"

sora_scene_problem \
"Each phase was demonstrated on its own, which proves each piece works
and proves nothing about the combination. This map uses all of them at
once: the pool from phase 1, stations and delivery from phase 2, boxes
the generator wrote in phase 3, a gatherer and a statics table from
phase 4, a comparator and an iterator from phase 5, and the file
describing all of it from phase 6. The picture printed below is drawn
from the loaded station table rather than from the file, so it is a
description of what is actually in memory."

sora_scene_imagine \
"an orchestra's first full rehearsal. Every section has practised
alone and each sounds correct in an empty room. The rehearsal is not
about any one of them — it is about whether they can all play at once
without anybody's part making somebody else's impossible."

sora_scene_stands_for "one phase's machinery" "a section of the orchestra" \
"each was developed and verified separately by people concentrating on
it alone, and each is correct in isolation in a way that says nothing
about what happens beside the others"

sora_scene_stands_for "a single map file" "the score" \
"each is the one document that says what everybody does and when, and
each is the only place the combination exists at all"

sora_scene_stands_for "one process and one pool" "playing at the same time" \
"both are the actual test, because interference only exists when
things are simultaneous — running the sections one after another would
prove nothing"

sora_scene_stands_for "the dump from the station table" "the conductor's view" \
"each sees the whole arrangement as it actually is rather than as
written, which is the only vantage point from which a conflict is
visible"

sed -e "s|OUT_A|${WORK}/everything-a.txt|" -e "s|OUT_B|${WORK}/everything-b.txt|" \
    "${MAPS}/048-everything.map" > "${WORK}/everything.map"

sora_scene_blank
"${RUNNER}" "${WORK}/everything.map" 2>&1 | sora_scene_quote

sora_scene_measured "sections playing" "6" "every phase, at once"
sora_scene_measured "output a" "$(cat "${WORK}/everything-a.txt")" "written by the map"
sora_scene_measured "output b" "$(cat "${WORK}/everything-b.txt")" "written by the map"

sora_scene_finding \
"The pool from phase 1, stations and delivery from phase 2, boxes the
generator wrote in phase 3, a gatherer and a statics table from phase
4, a comparator and an iterator from phase 5, and the file that
describes all of it from phase 6 — one map, one process, no
conflicts. The picture above was drawn from the station table rather
than from the file, so it is a description of what is actually loaded
and not a re-reading of what was asked for."

sora_demo_close "=== a program is a directory of C functions and a text file ==="

echo
echo "report mirrored at ${DIR}/tmp/shared-memory/phase-6-capstone-report.txt"
